# Copy this file to .env (in the hw4 folder) and fill in your own values.
# .env is git-ignored. Never commit a real key.

# Required for the chatbot: your Portkey API key.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional settings (defaults shown).
# OPENAI_MODEL=gpt-5.6-luna
# OPENAI_REASONING_EFFORT=low
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# Only needed if your Portkey key has no default provider (plain values like "openai").
# PORTKEY_PROVIDER=
# Set to true when the site is served over HTTPS.
# SESSION_COOKIE_SECURE=false

# Set these as shell environment variables, not in this file (they're read before .env loads):
#   CAMPUS_CUSTOMS_DATA_DIR=/absolute/path/to/data   (default: hw4/data)
#   CAMPUS_CUSTOMS_ENV_FILE=/absolute/path/to/.env   (default: hw4/.env, then the class-folder Portkey.env)
